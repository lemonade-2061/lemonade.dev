---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header class="post-header">
					<p class="filepath" aria-hidden="true">~/blog/post.md</p>
					<h1>{title}</h1>
					<p class="meta">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="updated">(updated: <FormattedDate date={updatedDate} />)</span>
						)}
					</p>
				</header>

				{heroImage && (
					<Image class="hero-image" width={1020} height={510} src={heroImage} alt="" />
				)}

				<div class="prose">
					<slot />
				</div>

				<footer class="post-footer">
					<a class="back" href="/blog">cd ../blog</a>
				</footer>
			</article>
		</main>
		<Footer />
	</body>
	<style>
		.filepath {
			margin: 0 0 0.4em;
			font-family: ui-monospace, "JetBrains Mono", "Cascadia Code", monospace;
			font-size: 0.85rem;
			color: var(--text-muted);
		}

		.post-header {
			margin-bottom: 2.2em;
			padding-bottom: 1.2em;
			border-bottom: 1px dashed var(--border);
		}
		.post-header h1 {
			margin: 0 0 0.4em;
			font-size: 1.9rem;
		}

		.meta {
			margin: 0;
			font-family: ui-monospace, "JetBrains Mono", "Cascadia Code", monospace;
			font-size: 0.85rem;
			color: var(--ctp-green);
		}
		.meta .updated {
			margin-left: 0.8em;
			color: var(--text-muted);
		}

		.hero-image {
			display: block;
			margin: 0 0 2em;
			border-radius: 10px;
			border: 1px solid var(--border);
		}

		.prose :global(h2) {
			font-family: ui-monospace, "JetBrains Mono", "Cascadia Code", monospace;
			font-size: 1.2rem;
			margin: 1.8em 0 0.7em;
			padding-bottom: 0.35em;
			border-bottom: 1px dashed var(--border);
		}
		.prose :global(h2)::before {
			content: "## ";
			color: var(--ctp-mauve);
		}
		.prose :global(h3) {
			font-family: ui-monospace, "JetBrains Mono", "Cascadia Code", monospace;
			font-size: 1.05rem;
			margin: 1.5em 0 0.6em;
		}
		.prose :global(h3)::before {
			content: "### ";
			color: var(--ctp-mauve);
		}
		.prose :global(p) {
			margin: 0 0 1.1em;
		}
		.prose :global(ul),
		.prose :global(ol) {
			padding-left: 1.4em;
			margin: 0 0 1.1em;
		}
		.prose :global(li) {
			margin-bottom: 0.3em;
		}
		.prose :global(li)::marker {
			color: var(--ctp-yellow);
		}
		.prose :global(a) {
			color: var(--ctp-blue);
		}
		.prose :global(a:hover) {
			color: var(--ctp-yellow);
		}
		.prose :global(img) {
			border-radius: 10px;
			border: 1px solid var(--border);
		}

		.post-footer {
			margin-top: 3em;
			padding-top: 1.2em;
			border-top: 1px dashed var(--border);
		}
		.back {
			font-family: ui-monospace, "JetBrains Mono", "Cascadia Code", monospace;
			font-size: 0.9rem;
			color: var(--ctp-blue);
		}
		.back::before {
			content: "$ ";
			color: var(--ctp-mauve);
		}
		.back:hover {
			color: var(--ctp-yellow);
			text-decoration: none;
		}
	</style>
</html>
