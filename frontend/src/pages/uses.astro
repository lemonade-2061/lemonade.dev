---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const sections = [
	{
		title: 'Hardware',
		items: [
			{ name: 'IdeaPad Slim5 Gen10', desc: 'ノートPC' },
			{ name: '自作デスクトップ', desc: '家での作業用' },
			{ name: '60% キーボード', desc: '使いやすくて良き' },
		],
	},
	{
		title: 'Desktop',
		items: [
			{ name: 'Arch Linux', desc: 'DebianやFedoraなど使ったけどArchが一番使いやすかったかな' },
			{ name: 'Hyprland', desc: 'タイルに慣れたらKDEとかに戻れなくなったよね' },
			{ name: 'ghostty', desc: 'アイコンが可愛いから使ってる、たまにkittyとか使ってるかな' },
			{ name: 'zsh + starship', desc: 'おしゃれにしたいよねって感じ' },
		],
    },
    {
		title: 'Laptop',
		items: [
			{ name: 'NixOS', desc: '使ってみたかったからね' },
			{ name: 'ShojiWM', desc: '気になったので使ってみてる' },
			{ name: 'kitty', desc: '特に理由はない' },
			{ name: 'zsh + starship', desc: 'おしゃれにしたいよねって感じ' },
		],
	},

	{
		title: 'Editor',
		items: [
			{ name: 'Neovim', desc: '色々いじれていいよねって感じ' },
			{ name: 'JetBrains Mono', desc: '個人的に好きなフォント' },
			{ name: 'Catppuccin Mocha', desc: 'このカラースキームいいよね' },
		],
	},
	{
		title: 'CLI Tools',
		items: [
			{ name: 'git + lazygit', desc: 'バージョン管理。TUI に頼っている。' },
			{ name: 'ripgrep / fd / fzf', desc: '検索三種の神器。これがないと生きていけない。' },
			{ name: 'tmux', desc: 'ターミナルマルチプレクサ。セッションを開きっぱなしにしがち。' },
			{ name: 'yay', desc: 'AUR ヘルパー。' },
		],
	},
	{
		title: 'Services',
		items: [
			{ name: 'GitHub', desc: 'コードの置き場所。' },
			{ name: 'Cloudflare', desc: 'このサイトのホスティングと DNS。' },
		],
	},
];
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`Uses | ${SITE_TITLE}`} description="lemonade が使っている道具たち" />
	</head>
	<body>
		<Header />
		<main>
			<p class="filepath" aria-hidden="true">~/uses.md</p>
			<h1>Uses</h1>
			<p class="lead">ふだん使っている道具たち。ハードもソフトも、気に入ったものを長く使いたい派。</p>

			{sections.map((section) => (
				<section class="section">
					<h2><span class="hash">##</span> {section.title}</h2>
					<ul class="items">
						{section.items.map((item) => (
							<li class="item">
								<p class="item-name">{item.name}</p>
								<p class="item-desc">{item.desc}</p>
							</li>
						))}
					</ul>
				</section>
			))}

			<p class="note">
				環境は気分で変わるので、ここに書いてあるものが最新とは限りません。
			</p>
		</main>
		<Footer />
	</body>
	<style>
		.filepath {
			margin: 0 0 0.4em;
			font-family: ui-monospace, "JetBrains Mono", "Cascadia Code", monospace;
			font-size: 0.85rem;
			color: var(--text-muted);
		}

		h1 {
			margin-bottom: 0.4em;
		}

		.lead {
			margin: 0 0 2.2em;
			color: var(--text-muted);
		}

		.section {
			margin-bottom: 2.6em;
		}

		.section h2 {
			font-family: ui-monospace, "JetBrains Mono", "Cascadia Code", monospace;
			font-size: 1.15rem;
			margin-bottom: 0.9em;
			padding-bottom: 0.4em;
			border-bottom: 1px dashed var(--border);
		}
		.hash {
			color: var(--ctp-mauve);
			margin-right: 0.4em;
		}

		.items {
			list-style: none;
			margin: 0;
			padding: 0;
			display: grid;
			gap: 0.7em;
		}

		.item {
			display: grid;
			grid-template-columns: 11em 1fr;
			gap: 1.2em;
			align-items: baseline;
			padding: 0.55em 0.9em;
			border-radius: 8px;
			transition: background 0.15s ease;
		}
		.item:hover {
			background: var(--ctp-mantle);
		}

		.item-name {
			margin: 0;
			font-family: ui-monospace, "JetBrains Mono", "Cascadia Code", monospace;
			font-size: 0.9rem;
			font-weight: bold;
			color: var(--ctp-yellow);
		}
		.item-name::before {
			content: "▸ ";
			color: var(--ctp-mauve);
		}

		.item-desc {
			margin: 0;
			font-size: 0.92rem;
			color: var(--ctp-subtext1);
		}

		.note {
			margin-top: 3em;
			padding-top: 1em;
			border-top: 1px dashed var(--border);
			font-size: 0.85rem;
			color: var(--text-muted);
		}

		@media (max-width: 560px) {
			.item {
				grid-template-columns: 1fr;
				gap: 0.2em;
			}
		}
	</style>
</html>
