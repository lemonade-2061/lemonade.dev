---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`404 | ${SITE_TITLE}`} description="ページが見つかりませんでした" />
	</head>
	<body>
		<Header />
		<main>
			<section class="terminal" aria-label="404">
				<div class="titlebar" aria-hidden="true">
					<span class="dots">
						<span class="dot red"></span>
						<span class="dot yellow"></span>
						<span class="dot green"></span>
					</span>
				</div>
				<div class="body">
					<p class="prompt">
						<span class="user">lemonade@dev</span><span class="sep">:</span><span class="path">~</span><span class="dollar">$</span> cat {Astro.url.pathname}
					</p>
					<p class="error">cat: {Astro.url.pathname}: No such file or directory</p>
					<p class="code" aria-hidden="true">404</p>
					<p class="hint">お探しのページは存在しないか、移動しました。</p>
					<p class="prompt">
						<span class="user">lemonade@dev</span><span class="sep">:</span><span class="path">~</span><span class="dollar">$</span> <a class="cmd" href="/">cd ~</a><span class="cursor" aria-hidden="true"></span>
					</p>
				</div>
			</section>
		</main>
		<Footer />
	</body>
	<style>
		main {
			display: flex;
			align-items: center;
			min-height: calc(100vh - 16em);
		}

		.terminal {
			width: 100%;
			background: var(--ctp-mantle);
			border: 1px solid var(--border);
			border-radius: 12px;
			overflow: hidden;
			box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
			font-family: ui-monospace, "JetBrains Mono", "Cascadia Code", monospace;
		}

		.titlebar {
			display: flex;
			align-items: center;
			padding: 0.7em 1em;
			background: var(--ctp-crust);
			border-bottom: 1px solid var(--border);
		}
		.dots {
			display: flex;
			gap: 0.5em;
		}
		.dot {
			width: 0.78em;
			height: 0.78em;
			border-radius: 50%;
			display: inline-block;
		}
		.dot.red { background: var(--ctp-red); }
		.dot.yellow { background: var(--ctp-yellow); }
		.dot.green { background: var(--ctp-green); }

		.body {
			padding: 1.6em 1.8em 1.8em;
			font-size: 0.95rem;
		}

		.prompt {
			margin: 0;
			color: var(--text-muted);
		}
		.prompt .user { color: var(--ctp-green); font-weight: bold; }
		.prompt .path { color: var(--ctp-blue); font-weight: bold; }
		.prompt .dollar { color: var(--ctp-mauve); margin: 0 0.4em 0 0.3em; }

		.error {
			margin: 0.3em 0 0;
			color: var(--ctp-red);
		}

		.code {
			margin: 0.2em 0;
			font-size: 4.5rem;
			font-weight: bold;
			line-height: 1.2;
			color: var(--ctp-yellow);
		}

		.hint {
			margin: 0 0 1.6em;
			color: var(--text-muted);
		}

		.cmd {
			color: var(--ctp-blue);
		}
		.cmd:hover {
			color: var(--ctp-yellow);
			text-decoration: none;
		}

		.cursor {
			display: inline-block;
			width: 0.55em;
			height: 1.05em;
			margin-left: 0.35em;
			background: var(--ctp-text);
			vertical-align: text-bottom;
			animation: blink 1.1s steps(1) infinite;
		}
		@keyframes blink {
			50% { opacity: 0; }
		}
	</style>
</html>
