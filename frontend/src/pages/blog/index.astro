---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description="lemonade のブログ" />
	</head>
	<body>
		<Header />
		<main>
			<p class="filepath" aria-hidden="true">~/blog</p>
			<h1>Blog</h1>
			<p class="lead">低レイヤのこと、Linux のこと、作っているもののこと。</p>

			{posts.length === 0 ? (
				<p class="empty">
					<span class="prompt-mark" aria-hidden="true">$</span> ls: まだ記事がありません
				</p>
			) : (
				<ul class="posts">
					{posts.map((post) => (
						<li>
							<a class="post" href={`/blog/${post.id}/`}>
								<div class="post-head">
									<h2 class="post-title">{post.data.title}</h2>
									<p class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</div>
								{post.data.description && (
									<p class="post-desc">{post.data.description}</p>
								)}
							</a>
						</li>
					))}
				</ul>
			)}

			<p class="rss">
				<a href="/rss.xml">RSS</a> で購読できます。
			</p>
		</main>
		<Footer />
	</body>
	<style>
		.filepath {
			margin: 0 0 0.4em;
			font-family: ui-monospace, "JetBrains Mono", "Cascadia Code", monospace;
			font-size: 0.85rem;
			color: var(--text-muted);
		}

		h1 {
			margin-bottom: 0.4em;
		}

		.lead {
			margin: 0 0 2.2em;
			color: var(--text-muted);
		}

		.empty {
			font-family: ui-monospace, "JetBrains Mono", "Cascadia Code", monospace;
			color: var(--text-muted);
		}
		.prompt-mark {
			color: var(--ctp-mauve);
			margin-right: 0.5em;
		}

		.posts {
			list-style: none;
			margin: 0;
			padding: 0;
			display: grid;
			gap: 0.6em;
		}

		.post {
			display: block;
			padding: 0.9em 1.1em;
			border-radius: 10px;
			border: 1px solid transparent;
			text-decoration: none;
			transition: background 0.15s ease, border-color 0.15s ease;
		}
		.post:hover {
			background: var(--ctp-mantle);
			border-color: var(--border);
			text-decoration: none;
		}

		.post-head {
			display: flex;
			align-items: baseline;
			justify-content: space-between;
			gap: 1.2em;
		}

		.post-title {
			margin: 0;
			font-size: 1.05rem;
			color: var(--text);
			transition: color 0.15s ease;
		}
		.post:hover .post-title {
			color: var(--ctp-yellow);
		}

		.post-date {
			margin: 0;
			flex: none;
			font-family: ui-monospace, "JetBrains Mono", "Cascadia Code", monospace;
			font-size: 0.82rem;
			color: var(--text-muted);
		}

		.post-desc {
			margin: 0.35em 0 0;
			font-size: 0.9rem;
			color: var(--ctp-subtext1);
		}

		.rss {
			margin-top: 3em;
			padding-top: 1em;
			border-top: 1px dashed var(--border);
			font-size: 0.85rem;
			color: var(--text-muted);
		}
		.rss a {
			font-family: ui-monospace, "JetBrains Mono", "Cascadia Code", monospace;
			color: var(--ctp-peach);
		}

		@media (max-width: 560px) {
			.post-head {
				flex-direction: column;
				gap: 0.15em;
			}
		}
	</style>
</html>
